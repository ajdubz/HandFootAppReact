REACT_APP_DATA_BACKEND=mock
REACT_APP_API_URL=mock

# Use REACT_APP_DATA_BACKEND=api with the sibling FastAPI backend.
# REACT_APP_API_URL=http://127.0.0.1:8000

# Use REACT_APP_DATA_BACKEND=firebase for Firebase Auth and Firestore.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Optional local emulator settings.
REACT_APP_FIREBASE_USE_EMULATORS=false
REACT_APP_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
REACT_APP_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
REACT_APP_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
